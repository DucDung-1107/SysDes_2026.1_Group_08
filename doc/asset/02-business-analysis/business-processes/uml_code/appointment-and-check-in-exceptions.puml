@startuml
title MEDORA: Appointment Booking and Check-in Exceptions
!include ../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 16
skinparam wrapWidth 150
skinparam maxMessageSize 150
|Receptionist|
start
:Receive booking or arrival request;
:Search patient using an approved identifier;
if (Patient record found?) then (yes)
  :Confirm permitted identity and contact details;
else (no)
  :Create a provisional patient record;
  if (Possible duplicate?) then (yes)
    :Flag record for authorized merge review;
  else (no)
    :Continue with the provisional record;
  endif
endif
if (Request is a walk-in?) then (yes)
  :Check facility acceptance policy;
  if (Accepted?) then (yes)
    :Create Encounter and assign queue;
    stop
  else (no)
    :Provide the next permitted action;
    stop
  endif
else (no)
  :Select provider, service and requested time;
endif
|MEDORA System|
:Validate schedule, duration and required resources;
if (Slot available?) then (yes)
  :Commit appointment and record actor and time;
else (no)
  :Return available alternatives without creating a booking;
  stop
endif
|Receptionist|
:At arrival, check in appointment;
|MEDORA System|
:Create or activate Encounter and assign role-scoped queue;
stop
@enduml
