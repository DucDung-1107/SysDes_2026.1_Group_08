@startuml
title MEDORA -- Functional Decomposition
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam backgroundColor #F5F9FE
skinparam ArrowColor #2563A6
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #EAF3FB
  BorderColor #163A5F
  FontColor #163A5F
}
skinparam component {
  BackgroundColor #F5F9FE
  BorderColor #2563A6
  FontColor #183247
}

package "Identity and Access" as identity {
  [Authentication and Session]
  [Patient Identity and Duplicate Control]
  [Longitudinal Record Search]
  [Role and Scope Control]
}

package "Scheduling and Reception" as reception {
  [Appointment Management]
  [Check-in and Queue]
  [Resource Availability]
  [Operational Notifications]
}

package "Clinical Care" as clinical {
  [Screening and Vital Signs]
  [Encounter Documentation]
  [Diagnosis, Closure and Follow-up]
}

package "Orders and Execution" as orders {
  [Prescription and Safety]
  [Medicine Event Recording]
  [Service / Procedure Order]
  [Resource Allocation and Execution Result]
}

package "Finance and Operations" as operations {
  [Invoice and Payment]
  [Dashboard and Reports]
  [Service and Price Catalogue]
}

package "Governance" as governance {
  [Account and Facility Administration]
  [Clinical and Operational Catalogues]
  [Attachment Control]
  [Audit Trail]
  [Controlled Export]
}

@enduml
