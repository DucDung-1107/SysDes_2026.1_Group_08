@startuml
title MEDORA -- Prescription and Medication Safety Use Cases
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam backgroundColor #F5F9FE
skinparam ArrowColor #2563A6
skinparam UsecaseBackgroundColor #EAF3FB
skinparam UsecaseBorderColor #2563A6
skinparam UsecaseFontColor #183247
skinparam ActorBorderColor #163A5F
skinparam ActorFontColor #183247
skinparam RectangleBackgroundColor #F5F9FE
skinparam RectangleBorderColor #163A5F

actor Doctor as doctor
actor "Pharmacist /\nMedicine Staff" as pharmacist
actor "Clinic Manager" as manager

rectangle "Prescription and Medication Safety" {
  usecase "UC-043\nCreate Prescription\nDraft" as draft
  usecase "UC-044\nAdd Medicine\nand Directions" as item
  usecase "UC-045\nSearch Approved\nMedicine Catalogue" as medicine
  usecase "UC-046\nCheck Medication\nSafety Rules" as warning
  usecase "UC-047\nOverride Safety\nWarning with Reason" as override
  usecase "UC-048\nValidate and Issue\nPrescription" as issue
  usecase "UC-049\nPrint or Export\nPrescription" as print
  usecase "UC-050\nAmend or Cancel\nPrescription" as amend
  usecase "UC-051\nRecord Dispensing\nor Administration" as administer
  usecase "UC-052\nManage Medicine\nCatalogue and Rules" as catalogue
}

doctor -- draft
doctor -- issue
doctor -- print
doctor -- amend
doctor -- override
pharmacist -- administer
manager -- catalogue

item .> medicine : <<include>>
override .> issue : <<extend>>
issue .> item : <<include>>
issue .> warning : <<include>>

@enduml
