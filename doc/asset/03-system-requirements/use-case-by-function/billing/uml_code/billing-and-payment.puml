@startuml
title MEDORA: Billing and Payment Use Cases
!include ../../../../shared/templates/medora-style.puml
skinparam dpi 192
left to right direction

actor Cashier as cashier
actor "Authorized Finance\nStaff" as finance
actor "Clinic Manager" as manager

rectangle "MEDORA System\nBilling and Payment" {
  usecase "UC-060\nCreate Invoice\nfrom Eligible Items" as invoice
  usecase "UC-061\nApply Effective\nService Price" as price
  usecase "UC-062\nApply Authorized\nDiscount" as discount
  usecase "UC-063\nRecord Payment" as payment
  usecase "UC-064\nIssue Receipt" as receipt
  usecase "UC-065\nRecord Refund" as refund
  usecase "UC-066\nRecord Refund\nReason and Approval" as refundApproval
  usecase "UC-067\nView Invoice and\nPayment Status" as status
  usecase "UC-068\nManage Service\nand Price List" as priceList
  usecase "UC-069\nView Revenue\nReport" as revenue
}

cashier -- invoice
cashier -- payment
cashier -- receipt
cashier -- status
finance -- refund
finance -- discount
manager -- priceList
manager -- revenue

invoice .> price : <<include>>
discount .> invoice : <<extend>>\n[discount requested and authorized]
refund .> refundApproval : <<include>>

@enduml
