@startuml
title MEDORA -- Patient Management Use Cases
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EEF5F4
  BorderColor #087E8B
}

actor Receptionist as reception
actor Nurse as nurse
actor Doctor as doctor
actor "Authorized Registrar" as registrar
actor Auditor as auditor

rectangle "Patient Management" {
  usecase "Search patient" as search
  usecase "Register patient" as register
  usecase "Detect possible\nduplicate" as duplicate
  usecase "View longitudinal\nhealth record" as timeline
  usecase "Update permitted\nadministrative data" as update
  usecase "Record allergy and\npatient history" as history
  usecase "Upload / view\nattachments" as attachment
  usecase "Request duplicate\nrecord merge" as mergeRequest
  usecase "Approve and perform\nrecord merge" as merge
  usecase "Review patient-related\naudit events" as audit
}

reception --> search
reception --> register
reception --> update
reception --> mergeRequest
nurse --> search
nurse --> timeline
nurse --> history
doctor --> search
doctor --> timeline
doctor --> history
doctor --> attachment
registrar --> merge
auditor --> audit

register .> duplicate : <<include>>
mergeRequest .> search : <<include>>
merge .> mergeRequest : <<include>>
timeline .> search : <<include>>
audit .> timeline : <<extend>>

note bottom of merge
  A merge preserves source records,
  approver, reason and audit history.
end note
@enduml
