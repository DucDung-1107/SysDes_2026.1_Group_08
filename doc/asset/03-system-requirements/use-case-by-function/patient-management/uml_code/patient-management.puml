@startuml
title MEDORA: Patient Management Use Cases
!include ../../../../shared/templates/medora-style.puml
skinparam dpi 192
left to right direction

actor Receptionist as reception
actor Nurse as nurse
actor Doctor as doctor
actor "Authorized Registrar" as registrar
actor Auditor as auditor
actor Patient as patient

rectangle "MEDORA System\nPatient Management" {
  usecase "UC-010\nSearch Patient" as search
  usecase "UC-011\nRegister Patient" as register
  usecase "UC-012\nUpdate Patient\nAdministrative Data" as update
  usecase "UC-013\nView Longitudinal\nHealth Record" as timeline
  usecase "UC-014\nRecord Allergy\nand History" as history
  usecase "UC-015\nManage Attachment" as attachment
  usecase "UC-016\nRequest Record Merge" as mergeRequest
  usecase "UC-017\nPerform Record Merge" as merge
  usecase "UC-018\nDetect Possible\nDuplicate" as duplicate
  usecase "UC-019\nReview Patient\nAudit Events" as audit
  usecase "UC-055\nView Released\nDocuments" as releasedDocuments
}

reception -- search
reception -- register
reception -- update
reception -- mergeRequest
nurse -- search
nurse -- timeline
nurse -- history
doctor -- search
doctor -- timeline
doctor -- history
doctor -- attachment
registrar -- merge
auditor -- audit
patient -- releasedDocuments

register .> duplicate : <<include>>
mergeRequest .> search : <<include>>

note right of registrar
  UC-017 starts only from an existing UC-016 merge request.
  Only the Authorized Registrar performs a merge. A Receptionist may
  request one but cannot perform it.
end note

note right of patient
  Proposed Phase 2 portal interaction;
  not an MVP capability.
end note

@enduml
