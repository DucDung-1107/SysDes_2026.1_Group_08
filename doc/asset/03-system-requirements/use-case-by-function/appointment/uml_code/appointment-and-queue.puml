@startuml
title MEDORA -- Appointment Management Use Cases
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam backgroundColor #F5F9FE
skinparam ArrowColor #2563A6
skinparam UsecaseBackgroundColor #EAF3FB
skinparam UsecaseBorderColor #2563A6
skinparam UsecaseFontColor #183247
skinparam ActorBorderColor #163A5F
skinparam ActorFontColor #183247
skinparam RectangleBackgroundColor #F5F9FE
skinparam RectangleBorderColor #163A5F

actor Patient as patient
actor Receptionist as reception

rectangle "Appointment Management" {
  usecase "UC-020\nView Availability" as availability
  usecase "UC-021\nBook Appointment" as book
  usecase "UC-022\nConfirm Appointment" as confirm
  usecase "UC-023\nReschedule Appointment" as reschedule
  usecase "UC-024\nCancel Appointment" as cancel
  usecase "UC-025\nMark No-show" as noshow
  usecase "UC-026\nCheck Appointment\nAvailability" as validate
  usecase "UC-054\nSend Appointment\nor Instruction Notification" as notification
}

patient -- book : phase 2
reception -- availability
reception -- book
reception -- confirm
reception -- reschedule
reception -- cancel
reception -- noshow
reception -- notification

book .> validate : <<include>>
reschedule .> validate : <<include>>

@enduml
