@startuml
title MEDORA: Screening and Consultation Use Cases
!include ../../../../shared/templates/medora-style.puml
skinparam dpi 192
left to right direction

actor Nurse as nurse
actor Doctor as doctor

rectangle "MEDORA System\nScreening and Consultation Management" {
  usecase "UC-031\nOpen Assigned\nEncounter" as open
  usecase "UC-032\nReview Permitted\nClinical History" as review
  usecase "UC-033\nRecord Vital Signs\nand Screening" as vitals
  usecase "UC-034\nDocument Clinical\nExamination Note" as note
  usecase "UC-035\nRecord Symptoms\nand Diagnosis" as diagnosis
}

nurse -- open
nurse -- vitals
doctor -- open
doctor -- review
doctor -- note
doctor -- diagnosis
@enduml
