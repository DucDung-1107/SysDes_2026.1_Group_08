@startuml
title MEDORA -- Screening and Consultation Use Cases
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam backgroundColor #F5F9FE
skinparam ArrowColor #2563A6
skinparam UsecaseBackgroundColor #EAF3FB
skinparam UsecaseBorderColor #2563A6
skinparam UsecaseFontColor #183247
skinparam ActorBorderColor #163A5F
skinparam ActorFontColor #183247
skinparam RectangleBackgroundColor #F5F9FE
skinparam RectangleBorderColor #163A5F

actor Nurse as nurse
actor Doctor as doctor

rectangle "Screening and Consultation Management" {
  usecase "UC-031\nOpen Assigned\nEncounter" as open
  usecase "UC-032\nReview Permitted\nClinical History" as review
  usecase "UC-033\nRecord Vital Signs\nand Screening" as vitals
  usecase "UC-034\nDocument Clinical\nExamination Note" as note
  usecase "UC-035\nRecord Symptoms\nand Diagnosis" as diagnosis
}

nurse -- open
nurse -- vitals
doctor -- open
doctor -- review
doctor -- note
doctor -- diagnosis
note bottom of diagnosis
  FR-007 and FR-010: each recorded value or diagnosis is
  linked to the encounter, actor and capture time.
end note
@enduml
