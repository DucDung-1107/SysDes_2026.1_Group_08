@startuml
title MEDORA: Service Order and Execution Use Cases
!include ../../../../shared/templates/medora-style.puml
skinparam dpi 192
left to right direction

actor Doctor as doctor
actor "Technician /\nService Staff" as technician

rectangle "MEDORA System\nService Order and Execution Management" {
  usecase "UC-039\nCreate and Schedule\nService / Procedure Order" as order
  usecase "UC-056\nValidate Required\nResource Availability" as availability
  usecase "UC-057\nAllocate Room, Staff\nand Resource" as allocation
  usecase "UC-040\nRecord Service Execution\nand Result" as result
}

doctor -- order
technician -- result

order .> availability : <<include>>
order .> allocation : <<include>>

@enduml
