@startuml
title MEDORA -- Overall Use-Case Model
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam backgroundColor #F5F9FE
skinparam packageStyle rectangle
skinparam ArrowColor #2563A6
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
}
skinparam actor {
  BorderColor #163A5F
  FontColor #183247
}
skinparam rectangle {
  BackgroundColor #F5F9FE
  BorderColor #163A5F
  FontColor #163A5F
}

actor Patient as patient
actor "Authenticated\nInternal User" as user
actor Receptionist as reception
actor Nurse as nurse
actor Doctor as doctor
actor "Technician /\nService Staff" as technician
actor "Pharmacist /\nMedicine Staff" as pharmacist
actor Cashier as cashier
actor "Clinic Manager" as manager
actor "System Administrator" as admin
actor Auditor as auditor

rectangle "MEDORA -- Integrated Clinic Management and EMR System" {
  package "Patient and Access" {
    usecase "UC-001\nAuthenticate User" as UCAuth
    usecase "Manage Patient Record" as UCPatient
    usecase "Manage Appointment,\nCheck-in and Queue" as UCAppointment
  }
  package "Clinical Care" {
    usecase "Document Encounter" as UCEncounter
    usecase "Manage Prescription" as UCPrescription
    usecase "Manage Service Order\nand Execution" as UCService
  }
  package "Operations and Governance" {
    usecase "Manage Invoice\nand Payment" as UCBilling
    usecase "View Dashboard\nand Reports" as UCReporting
    usecase "Administer Access\nand Catalogues" as UCAdmin
    usecase "Review Audit Trail" as UCAudit
  }
}

patient -- UCAppointment : phased portal
user -- UCAuth
reception -- UCPatient
reception -- UCAppointment
reception -- UCBilling
nurse -- UCPatient
nurse -- UCEncounter
doctor -- UCPatient
doctor -- UCEncounter
doctor -- UCPrescription
doctor -- UCService
technician -- UCService
pharmacist -- UCPrescription
cashier -- UCBilling
manager -- UCReporting
manager -- UCAdmin
admin -- UCAdmin
admin -- UCAudit
auditor -- UCAudit


@enduml
