@startuml
title MEDORA: Overall Use-Case Model
!include ../../../shared/templates/medora-style.puml
skinparam dpi 192
left to right direction

actor Patient as patient
actor Receptionist as reception
actor "Clinical Care Staff\n(Nurse, Doctor, Service Staff,\nand Medicine Staff)" as clinical
actor "Financial Staff\n(Cashier and Authorized\nFinance Staff)" as financial

rectangle "MEDORA -- Integrated Clinic Management and EMR System" {
  package "Patient and Access" {
    usecase "UC-001\nAuthenticate User" as UCAuth
    usecase "Manage Patient Record" as UCPatient
    usecase "Manage Appointment,\nCheck-in and Queue" as UCAppointment
  }
  package "Clinical Care" {
    usecase "Document Encounter" as UCEncounter
    usecase "Manage Prescription" as UCPrescription
    usecase "Manage Service Order\nand Execution" as UCService
  }
  package "Operations and Governance" {
    usecase "Manage Invoice\nand Payment" as UCBilling
    usecase "View Dashboard\nand Reports" as UCReporting
    usecase "Administer Access\nand Catalogues" as UCAdmin
    usecase "Review Audit Trail" as UCAudit
  }
}

actor "Clinic Manager" as manager
actor "System Administrator" as admin
actor Auditor as auditor

patient -- UCAppointment
reception -- UCPatient
reception -- UCAppointment
clinical -- UCPatient
clinical -- UCEncounter
clinical -- UCPrescription
clinical -- UCService
financial -- UCBilling
manager -- UCReporting
manager -- UCAdmin
admin -- UCAdmin
admin -- UCAudit
auditor -- UCAudit

note right of patient
  Patient self-service is proposed for Phase 2;
  it is not an MVP capability.
end note

note right of UCAuth
  Every staff actor authenticates before using
  any role-scoped function.
end note

note bottom of clinical
  Role groups are used only in this overview.
  Focused diagrams retain canonical role names.
end note

@enduml
