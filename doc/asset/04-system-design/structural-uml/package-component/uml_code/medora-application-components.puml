@startuml
title MEDORA -- Proposed Application Components
skinparam dpi 192
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam defaultFontSize 14
skinparam titleFontSize 18
skinparam backgroundColor #F5F9FE
skinparam ArrowColor #2563A6
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam component {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
}
skinparam database {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
}

top to bottom direction
skinparam ranksep 35

component "Role-specific workspaces" as UI
component "Authenticated API boundary\n(identity, role and scope checks)" as API
component "Use-case controllers\n(booking, encounter, orders, finance)" as Controllers
component "Domain rules and services\n(state, validation, resource checks)" as Domain
component "Repository interfaces\n(controlled persistence access)" as Repositories
database "Logical relational store\n(engine TBD)" as Store

UI --> API
API --> Controllers
Controllers --> Domain
Domain --> Repositories
Repositories --> Store
@enduml

