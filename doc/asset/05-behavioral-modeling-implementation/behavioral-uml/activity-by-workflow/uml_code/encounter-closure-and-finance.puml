@startuml
title MEDORA -- Encounter Closure and Financial Settlement
skinparam shadowing false
skinparam dpi 192
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam defaultFontSize 16
skinparam titleFontSize 20
skinparam note {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
}
skinparam backgroundColor #F5F9FE
skinparam ArrowColor #2563A6
skinparam activity {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #163A5F
  BarColor #2A9D9F
}
skinparam partition {
  BackgroundColor #F5F9FE
  BorderColor #163A5F
  FontColor #163A5F
}
start
partition Doctor {
  :Prepare encounter summary and follow-up plan;
  :Submit encounter for completion;
}
partition MEDORA {
  :Authorize doctor and validate encounter state;
  :Check required clinical fields and unresolved mandatory work;
  if (Closure checklist satisfied?) then (yes)
    :Sign summary and complete encounter;
  else (no)
    :Keep encounter open and identify missing items;
    stop
  endif
  :Prepare eligible billable items independently;
}
partition Cashier {
  :Review eligible invoice items;
  :Issue invoice;
  :Record payment or leave balance outstanding;
}
partition MEDORA {
  :Append invoice and payment events;
  note right
    Clinical encounter completion and financial settlement are
    separate lifecycles. Unpaid balance does not rewrite signed care.
  end note
}
stop
@enduml