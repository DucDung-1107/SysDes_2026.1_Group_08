@startuml
title MEDORA: Service Order Allocation and Execution
!include ../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 18
skinparam titleFontSize 18
skinparam wrapWidth 200
skinparam maxMessageSize 200
|Doctor|
start
:Create service order (encounter, service, reason, priority);
|MEDORA System|
:Authorize actor and validate order data;
if (Order valid?) then (yes)
  :Check staff, room and resource availability;
  if (Complete allocation available?) then (yes)
    :Commit booking and schedule order;
  else (no)
    :Keep order pending and return next action;
    stop
  endif
else (no)
  :Reject order; book no resources;
  stop
endif

|Assigned Service Staff|
:Open scheduled order and start service;
|MEDORA System|
:Validate assignment and current state;
if (Execution may proceed?) then (yes)
  :Record start actor and time;
else (no)
  :Reject transition; preserve state;
  stop
endif

|Assigned Service Staff|
:Perform service and enter outcome;
|MEDORA System|
if (Required result complete?) then (yes)
  :Record completion and release booked resources;
else (no)
  :Keep order in progress and request correction;
  |Assigned Service Staff|
  :Correct and resubmit outcome;
  |MEDORA System|
  :Validate the corrected outcome;
  :Record completion and release booked resources;
endif
stop
@enduml
