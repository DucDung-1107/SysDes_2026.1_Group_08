@startuml
title MEDORA: Validate and Issue Prescription (System Sequence)
!include ../../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 13
skinparam titleFontSize 18
hide footbox
autonumber
actor Doctor
participant "MEDORA System" as System

Doctor -> System: issuePrescription(draftRef, requestKey)
alt required data invalid or actor unauthorized
  System -->> Doctor: PrescriptionResult(rejected, reason)
  note right: The prescription draft remains unchanged.
else blocking safety warning raised
  System -->> Doctor: PrescriptionWarning(warningDetails)
  alt doctor does not proceed
    Doctor -> System: retainDraft(draftRef)
    System -->> Doctor: PrescriptionResult(notIssued, draftRef)
  else override not permitted or lacks justification
    Doctor -> System: requestOverride(draftRef, reason)
    System -->> Doctor: PrescriptionResult(overrideRejected, reason)
    note right: The prescription draft remains unchanged.
  else override permitted and justified
    Doctor -> System: requestOverride(draftRef, reason)
    System -->> Doctor: PrescriptionResult(issued, prescriptionRef)
  end
else no blocking warning
  System -->> Doctor: PrescriptionResult(issued, prescriptionRef)
end
note over Doctor, System
  Issuing a prescription does not create a dispensing or
  medication-administration event.
end note
@enduml
