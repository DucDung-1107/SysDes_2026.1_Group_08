@startuml
title MEDORA -- Sign or Amend Clinical Note (System Sequence)
skinparam shadowing false
skinparam dpi 192
skinparam backgroundColor #F5F9FE
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam defaultFontSize 16
skinparam titleFontSize 20
skinparam note {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
}
skinparam ArrowColor #2563A6
skinparam sequence {
  ParticipantBackgroundColor #EAF3FB
  ParticipantBorderColor #163A5F
  ParticipantFontColor #183247
  LifeLineBorderColor #2563A6
  LifeLineBackgroundColor #F5F9FE
}
actor Doctor
participant "MEDORA System" as System

Doctor -> System: Save draft(encounter, note content)
activate System
System --> Doctor: Return draft status
Doctor -> System: Sign note(note reference)
alt Missing required data or stale version
  System --> Doctor: Reject signing; preserve draft for correction
else Valid draft
  System --> Doctor: Return signed version reference
  opt Correction requested after signing
    Doctor -> System: Request amendment(reason, corrected content)
    alt Amendment is unauthorized or invalid
      System --> Doctor: Reject amendment; preserve signed version
    else Amendment is permitted
      System --> Doctor: Return amendment draft; original remains unchanged
      Doctor -> System: Sign amendment
      System --> Doctor: Return amended-version reference
    end
  end
end
deactivate System
@enduml