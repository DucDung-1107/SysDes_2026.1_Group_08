@startuml
title MEDORA: Sign or Amend Clinical Note (System Sequence)
!include ../../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 13
skinparam titleFontSize 18
hide footbox
autonumber
actor Doctor
participant "MEDORA System" as System

Doctor -> System: saveDraft(encounterRef, noteContent)
alt draft save invalid or actor unauthorized
  System -->> Doctor: ClinicalNoteResult(rejected, reason)
  note right: No draft is created or changed.
else draft save valid
  System -->> Doctor: ClinicalNoteResult(draftSaved, draftRef)
  Doctor -> System: signNote(draftRef)
  alt required data missing or version stale
    System -->> Doctor: ClinicalNoteResult(signRejected, reason)
    note right: The draft is preserved for correction.
  else draft valid
    System -->> Doctor: ClinicalNoteResult(signed, versionRef)
    opt correction requested after signing
      Doctor -> System: requestAmendment(versionRef, reason, correctedContent)
      alt amendment unauthorized or invalid
        System -->> Doctor: ClinicalNoteResult(amendmentRejected, reason)
        note right: The signed version is preserved.
      else amendment permitted
        System -->> Doctor: ClinicalNoteResult(amendmentDraft, amendmentRef)
        note right: The original signed version remains unchanged.
        Doctor -> System: signAmendment(amendmentRef)
        System -->> Doctor: ClinicalNoteResult(amendedVersionSigned, versionRef)
      end
    end
  end
end
@enduml
