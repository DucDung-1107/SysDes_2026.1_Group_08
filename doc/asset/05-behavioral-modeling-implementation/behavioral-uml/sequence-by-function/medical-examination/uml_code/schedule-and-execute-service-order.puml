@startuml
title MEDORA: Schedule and Execute Service Order (System Sequence)
!include ../../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam maxMessageSize 260
hide footbox
autonumber
actor Doctor
participant "MEDORA System" as System
actor "Service Staff" as Staff

Doctor -> System: createServiceOrder(encounterRef, service, priority)
alt order data invalid or actor unauthorized
  System -->> Doctor: ServiceOrderResult(rejected, reason)
  note right: No order or resource booking is created.
else order valid
  System -->> Doctor: ServiceOrderResult(created, orderRef, pendingAllocation)
  Doctor -> System: requestSchedule(orderRef)
  alt no valid allocation available
    System -->> Doctor: ScheduleResult(pending, nextAction)
    note right: The order is retained; no resource booking is committed.
  else valid allocation available
    System -->> Doctor: ScheduleResult(scheduled, allocationRef)
    Staff -> System: viewAssignedOrder(orderRef)
    System -->> Staff: AssignedOrder(orderRef, scheduledDetails)
    Staff -> System: startServiceOrder(orderRef)
    alt assignment no longer valid
      System -->> Staff: ServiceStartResult(rejected, reason)
      note right: The scheduled order is retained.
    else assignment valid
      System -->> Staff: ServiceStartResult(started)
      Staff -> System: recordServiceOutcome(orderRef, outcome)
      alt required result incomplete
        System -->> Staff: ServiceOutcomeResult(incomplete, correctionRequired)
      else required result complete
        System -->> Staff: ServiceOutcomeResult(completed)
      end
    end
  end
end
@enduml
