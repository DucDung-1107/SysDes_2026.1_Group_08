@startuml
title MEDORA: Book Appointment (System Sequence)
!include ../../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 13
skinparam titleFontSize 18
hide footbox
autonumber
actor Receptionist
participant "MEDORA System" as System

Receptionist -> System: bookAppointment(patient, service, provider, slot)
alt identity, permission, or facility scope invalid
  System -->> Receptionist: AppointmentResult(rejected, reason)
  note right: No appointment or resource booking is created.
else request valid
  alt slot unavailable or conflicting
    System -->> Receptionist: AppointmentResult(unavailable, alternatives)
    note right: No appointment or resource booking is created.
  else slot available
    System -->> Receptionist: AppointmentResult(booked, appointmentRef, status)
  end
end
@enduml
