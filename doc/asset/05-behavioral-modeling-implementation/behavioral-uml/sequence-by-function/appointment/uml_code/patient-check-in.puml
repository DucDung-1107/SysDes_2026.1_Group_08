@startuml
title MEDORA: Check In Patient (System Sequence)
!include ../../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 13
skinparam titleFontSize 18
hide footbox
autonumber
actor Receptionist
participant "MEDORA System" as System

Receptionist -> System: checkInPatient(patient, appointmentRefOrWalkIn)
alt request unauthorized or identity unresolved
  System -->> Receptionist: CheckInResult(rejected, reason)
  note right: No encounter or queue state changes.
else request valid
  alt conflicting active encounter
    System -->> Receptionist: CheckInResult(rejected, duplicateEncounter)
    note right: The existing encounter state is preserved.
  else no conflicting active encounter
    System -->> Receptionist: CheckInResult(accepted, encounterRef, queueStatus)
  end
end
@enduml
