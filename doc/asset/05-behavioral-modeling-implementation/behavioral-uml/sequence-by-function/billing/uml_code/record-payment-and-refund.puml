@startuml
title MEDORA: Payment and Refund (System Sequence)
!include ../../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam maxMessageSize 260
hide footbox
autonumber
actor Cashier
participant "MEDORA System" as System
actor "Authorized Finance Staff" as Finance

Cashier -> System: recordPayment(invoiceRef, amount, method, requestKey)
alt invalid amount, invoice state, or duplicate request
  System -->> Cashier: PaymentResult(rejected, reason)
  note right: No financial state change.
else payment request valid
  System -->> Cashier: PaymentResult(accepted, transactionRef, invoiceStatus)
end

Finance -> System: requestRefund(originalTransactionRef, amount, reason)
alt refund request invalid
  System -->> Finance: RefundResult(rejected, reason)
  note right: Original transaction retained.
else approval required
  System -->> Finance: RefundPendingApproval(requestRef)
  note right
    Refund not completed; no resulting balance is reported.
    Approval is a separate interaction (UC-066). The approver differs
    from the requester and is permitted in the access matrix.
  end note
else refund authorized and permitted
  System -->> Finance: RefundResult(completed, refundRef, resultingBalance)
end
note over Cashier, Finance
  Payment and refund are separate financial events. Neither changes
  clinical content; external payment gateways are out of scope.
end note
@enduml
