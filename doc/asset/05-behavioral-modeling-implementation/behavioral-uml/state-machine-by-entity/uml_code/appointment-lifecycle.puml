@startuml
title MEDORA: Appointment Lifecycle to Check-in
!include ../../../../shared/templates/medora-style.puml
skinparam dpi 192
skinparam defaultFontSize 14
skinparam titleFontSize 18
[*] --> Draft : create()
Draft --> Draft : validate()\n[invalid identity, scope, or slot]
Draft --> Booked : validate()\n[identity, scope, and slot valid]
Booked --> Confirmed : confirm()
Booked --> Booked : reschedule()\n[new slot valid]
Confirmed --> Confirmed : reschedule()\n[new slot valid]
Booked --> Cancelled : cancel()\n[authorized]
Confirmed --> Cancelled : cancel()\n[authorized]
Confirmed --> NoShow : markNoShow()\n[policy permits]
Confirmed --> CheckedIn : checkIn()\n[identity and encounter state valid] \n/ open encounter
Cancelled --> [*]
NoShow --> [*]
CheckedIn --> [*]
@enduml
