@startuml
title MEDORA -- Procedure Order Lifecycle
skinparam shadowing false
skinparam dpi 192
skinparam backgroundColor #F5F9FE
skinparam defaultFontName Arial
skinparam defaultFontColor #183247
skinparam defaultFontSize 18
skinparam titleFontSize 22
skinparam note {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
}
skinparam ArrowColor #2563A6
skinparam state {
  BackgroundColor #EAF3FB
  BorderColor #2563A6
  FontColor #183247
  FontSize 18
  ArrowColor #2563A6
}
[*] --> Created : clinician submits order
Created --> PendingAllocation : order validated
PendingAllocation --> PendingAllocation : retry [resource unavailable]
PendingAllocation --> Scheduled : allocate [resources available]
Scheduled --> InProgress : start [assigned staff]
InProgress --> Completed : required outcome recorded
Scheduled --> Delayed : authorized delay recorded
Delayed --> Scheduled : reallocate [slot available]
Created --> Cancelled : cancel [authorized]
PendingAllocation --> Cancelled : cancel [authorized]
Scheduled --> Cancelled : cancel [release resources]
InProgress --> NotPerformed : stop [reason recorded]
Delayed --> Cancelled : cancel [authorized]
Completed --> [*]
Cancelled --> [*]
NotPerformed --> [*]
@enduml