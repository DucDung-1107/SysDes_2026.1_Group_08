API_PORT=8080

POSTGRES_DB=medora
POSTGRES_USER=medora
POSTGRES_PASSWORD=medora_dev_password

# Local synthetic demo only. Set your own password (12+ characters, <=72 UTF-8 bytes).
# The dev bootstrap creates admin.demo only when the account table is empty.
SPRING_PROFILES_ACTIVE=dev
MEDORA_BOOTSTRAP_PASSWORD=
SESSION_COOKIE_SECURE=false
MEDORA_FACILITY_ZONE=Asia/Ho_Chi_Minh
MEDORA_WALK_IN_ENABLED=true

# Private filesystem storage for local development; configurable S3-compatible driver.
MEDORA_STORAGE_DRIVER=filesystem
MEDORA_S3_ENDPOINT=
MEDORA_S3_REGION=us-east-1
MEDORA_S3_BUCKET=medora-private
MEDORA_S3_ACCESS_KEY=
MEDORA_S3_SECRET_KEY=
